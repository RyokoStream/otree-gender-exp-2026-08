{% extends "global/Page.html" %}
{% load otree %}

{% block title %}
    【練習2】プレイヤーB の計算結果
{% endblock %}

{% block content %}
    <div class="card mb-4" style="background-color: #f8f9fa;">
        <div class="card-body">
            <p>あなたの入力した p: <strong>{{ my_p }}</strong></p>
            <p>相手（想定）が入力した p: <strong>{{ other_p }}</strong></p>
            <hr>
            <p style="font-size: 1.1rem; color: #0d6efd; font-weight: bold; margin: 0;">
                集計された平均 P: {{ group_P }}
            </p>
        </div>
    </div>

    <p>プレイヤーB視点での各状況の対応金額：</p>
    <table class="table table-bordered text-center mb-4">
        <thead class="table-light">
            <tr>
                <th>発生する状況</th>
                <th>計算式</th>
                <th>対応金額</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="font-weight: bold; color: #198754;">状況 1</td>
                <td>{{ group_P }} × 2,000円</td>
                <td style="font-weight: bold;">{{ amount_result1 }} 円</td>
            </tr>
            <tr>
                <td style="font-weight: bold; color: #6c757d;">状況 2</td>
                <td>(1 - {{ group_P }}) × 2,000円</td>
                <td style="font-weight: bold;">{{ amount_result2 }} 円</td>
            </tr>
        </tbody>
    </table>

    <div class="alert alert-success text-center font-weight-bold mb-4">
        これで両方の立場のシミュレーションが完了しました！準備ができたら本番に進みましょう。
    </div>

    <div class="mt-4 text-center">
        <button class="otree-btn-next btn btn-primary btn-lg">理解できたので本番実験に進む</button>
    </div>
{% endblock %}
